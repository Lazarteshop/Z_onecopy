# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PORTAL: Admin credentials for accessing full control panel
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AdminSecurePassword123"
ADMIN_NAME="System Administrator"

# FIREBASE_SERVICE_ACCOUNT (Optional, required for external deployments like Render.com)
# Set this to your complete Google Cloud/Firebase Service Account JSON string to authenticate Firestore outside GCP.
FIREBASE_SERVICE_ACCOUNT=

# CLOUDFLARE R2 OBJECT STORAGE (Permanent Media Storage)
# S3-compatible credentials and endpoint configuration for permanent images and videos
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="z-oneapp-media"
# Production custom domain (e.g. https://media.z-oneapp.ph)
R2_PUBLIC_DOMAIN="https://media.z-oneapp.ph"
